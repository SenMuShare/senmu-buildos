{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/codex/hooks/session-start.js\"",
            "timeout": 5,
            "additionalContextLimit": 1000,
            "statusMessage": "Restoring Senmu BuildOS governance kernel..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/codex/hooks/subagent-start.js\"",
            "timeout": 5,
            "additionalContextLimit": 500,
            "statusMessage": "Restoring Senmu BuildOS subagent boundaries..."
          }
        ]
      }
    ]
  }
}
