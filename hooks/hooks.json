{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT||process.env.ZCODE_PLUGIN_ROOT;if(!r){console.error('BuildOS hook: plugin root is unavailable');process.exit(1)}require(r+'/hooks/session-start.js')\"",
            "timeout": 5,
            "additionalContextLimit": 1700,
            "statusMessage": "Restoring Senmu BuildOS governance kernel..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT||process.env.ZCODE_PLUGIN_ROOT;if(!r){console.error('BuildOS hook: plugin root is unavailable');process.exit(1)}require(r+'/hooks/subagent-start.js')\"",
            "timeout": 5,
            "additionalContextLimit": 1200,
            "statusMessage": "Restoring Senmu BuildOS subagent boundaries..."
          }
        ]
      }
    ]
  }
}
