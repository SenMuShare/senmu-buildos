# 发布收口配置。先完成项目校准，再由正式部署入口在生产验证通过后调用清理脚本。
# 所有目录均相对权威项目根；制品目录只清理直接子目录。

ARTIFACT_CLEANUP_ENABLED=0
ARTIFACT_ROOT=delivery/artifacts
CURRENT_ARTIFACT=
PREVIOUS_ARTIFACT=
PINNED_ARTIFACTS=

# Docker 模式按 tag 或 digest 保留当前已验证版、已验证回滚版和显式例外，只清理当前主机受管仓库中的其他 tag。
# 远程镜像／制品仓库需要独立的项目生命周期策略，本配置不执行 registry 删除。
DOCKER_IMAGE_CLEANUP_ENABLED=0
MANAGED_IMAGE_REPOSITORIES=
CURRENT_IMAGES=
PREVIOUS_IMAGES=
PINNED_IMAGES=

# 一个配置对应一个实际资源面；本机、服务器、registry 不能互相代签。
RESOURCE_SURFACE=unspecified
# 留空使用调用环境的 Docker context；回执记录实际 context 和 engine ID。
DOCKER_CONTEXT=

# 启用前由项目校准受管范围、可重建性、停止写入和当前/已验证回滚/Pin。
# 每次发布由实际制品事实更新 CURRENT/PREVIOUS，不把模板初值当运行状态。
# 本模板只清受管、可重建的版本子目录和所选 Docker engine 的带标签镜像。
# 普通文件使用可恢复清理；容器、Volume、构建缓存、无归属镜像和 registry
# 由对应的项目原生生命周期管理，本模板不执行这些删除。
# planned/disabled 不是清理完成；apply 无候选为 no_candidates。
